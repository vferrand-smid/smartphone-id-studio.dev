{
  "name": "smartphone-id-dev",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "sanity dev",
    "dev:prod": "dotenv -e .env.production sanity dev",
    "dev:dev": "dotenv -e .env.development sanity dev",
    "dev:local": "dotenv -e .env.local sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "build:migrations": "tsc --build tsconfig.migrations.json",
    "migrate:wp-pages": "sanity migration run import-wp-rest --dataset dev --project uvnumxlz --no-dry-run",
    "migrate:pages": "sanity migration run import-wp-graphql --dataset dev --project uvnumxlz --no-dry-run",
    "count-pages": "tsx migrations/count-pages/index.ts",
    "count-pages-sanity": "tsx migrations/count-pages/countPagesSanity.ts",
    "delete-pages": "dotenv -e .env.development -- tsx migrations/tools/delete-pages.ts",
    "update-readcount": "tsx migrations/tools/update-readcount.ts"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@google-analytics/data": "^5.2.1",
    "@portabletext/sanity-bridge": "^1.1.15",
    "@sanity/cli": "^3.88.3",
    "@sanity/client": "^7.12.0",
    "@sanity/color-input": "^4.0.4",
    "@sanity/icons": "^3.7.0",
    "@sanity/insert-menu": "^1.1.11",
    "@sanity/presentation": "^2.0.0",
    "@sanity/preview-kit": "^6.1.1",
    "@sanity/types": "^3.88.3",
    "@sanity/ui": "^2.8.11",
    "@sanity/vision": "^4.11.0",
    "@sanity/visual-editing": "^2.13.21",
    "@sindresorhus/slugify": "^2.2.1",
    "@types/axios": "^0.14.4",
    "@types/dotenv": "^8.2.3",
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "framer-motion": "^12.4.3",
    "graphql": "^16.11.0",
    "graphql-request": "^7.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-is": "^18.2.0",
    "sanity": "^4.11.0",
    "sanity-plugin-media": "^4.0.0",
    "slugify": "^1.6.6",
    "styled-components": "^6.1.18"
  },
  "overrides": {
    "@sanity/types": "^3.88.3"
  },
  "devDependencies": {
    "@portabletext/block-tools": "^3.5.11",
    "@sanity/eslint-config-studio": "^5.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.0.25",
    "@wordpress/block-serialization-default-parser": "^5.22.0",
    "dotenv-cli": "^8.0.0",
    "env-cmd": "^10.1.0",
    "eslint": "^9.9.0",
    "html-entities": "^2.6.0",
    "jsdom": "^26.1.0",
    "p-limit": "^6.2.0",
    "prettier": "^3.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.1.6",
    "wp-types": "^4.68.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
