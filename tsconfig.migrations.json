{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/migrations",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "*": ["./*"]
    }
  },
  "include": ["migrations/**/*.ts"]
}
