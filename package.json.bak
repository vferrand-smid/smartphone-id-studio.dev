{
  "name": "smartphone-id-dev",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "build:migrations": "tsc --build tsconfig.migrations.json",
    "migrate:pages": "sanity migration run import-wp-graphql --dataset dev --project uvnumxlz --no-dry-run",
    "count-pages": "tsx migrations/count-pages/index.ts",
    "delete-pages": "dotenv -e .env -- tsx migrations/tools/delete-pages.ts"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/block-tools": "^3.70.0",
    "@sanity/cli": "^3.82.0",
    "@sanity/icons": "^3.6.0",
    "@sanity/vision": "^3.70.0",
    "@sanity/visual-editing": "^2.12.3",
    "@types/axios": "^0.14.4",
    "@types/dotenv": "^8.2.3",
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "framer-motion": "^12.4.3",
    "graphql-request": "^7.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^18.2.0",
    "sanity": "^3.84.0",
    "styled-components": "^6.1.8"
  },
  "devDependencies": {
    "@portabletext/block-tools": "^1.1.21",
    "@sanity/eslint-config-studio": "^5.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.0.25",
    "@wordpress/block-serialization-default-parser": "^5.22.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.9.0",
    "html-entities": "^2.6.0",
    "jsdom": "^26.1.0",
    "p-limit": "^6.2.0",
    "prettier": "^3.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.1.6",
    "wp-types": "^4.68.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
